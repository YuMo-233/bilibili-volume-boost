{
  "manifest_version": 3,
  "name": "B站音量增强",
  "version": "1.0.0",
  "description": "为B站视频与直播提供50%-300%音量增益，按UP主记忆音量，不破坏原生沉浸全屏。",
  "permissions": ["storage", "activeTab"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "B站音量增强",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/video/*", "https://live.bilibili.com/*"],
      "js": ["content/sniff.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.bilibili.com/video/*", "https://live.bilibili.com/*"],
      "js": ["content/audio-engine.js", "content/memory.js", "content/ui.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ]
}