{
  "manifest_version": 3,
  "default_locale": "zh_CN",
  "name": "__MSG_extName__",
  "version": "1.3.4",
  "description": "__MSG_extDesc__",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://api.live.bilibili.com/*", "https://api.bilibili.com/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/video/*", "https://www.bilibili.com/list/*", "https://live.bilibili.com/*"],
      "js": ["content/sniff.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.bilibili.com/video/*", "https://www.bilibili.com/list/*", "https://live.bilibili.com/*", "https://search.bilibili.com/*"],
      "js": ["content/audio-engine.js", "content/memory.js", "content/dislike-store.js", "content/ui.js", "content/superchat.js", "content/superchat-ui.js", "content/dislike-ui.js", "content/dislike.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ]
}