{
  "manifest_version": 3,
  "name": "B站音量增强",
  "version": "1.3.0",
  "description": "为 B 站视频与直播提供 50%-500% 音量增益（按 UP 主记忆，不破坏原生沉浸全屏），直播沉浸全屏时可在画面角落显示醒目留言。非官方第三方扩展，与哔哩哔哩无关联。",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://api.live.bilibili.com/*", "https://api.bilibili.com/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "B站音量增强",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/video/*", "https://live.bilibili.com/*"],
      "js": ["content/sniff.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.bilibili.com/video/*", "https://live.bilibili.com/*", "https://search.bilibili.com/*"],
      "js": ["content/audio-engine.js", "content/memory.js", "content/ui.js", "content/superchat.js", "content/superchat-ui.js", "content/dislike-ui.js", "content/dislike.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ]
}